# ---- Backend (copy to backend/.env) ----
# Secret used to sign login tokens. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# SQLite file (created automatically on first start)
DATABASE_URL=sqlite:///./tourplan.db

# Allowed frontend origins, comma separated
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- AI provider (optional) ----
# Leave GEMINI_API_KEY empty to run in clearly-labelled rule-based fallback mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Max AI requests per user per minute
AI_RATE_LIMIT_PER_MINUTE=10

# ---- Optional live data (leave empty to use labelled fallback) ----
# Weather: Open-Meteo needs no key. Set to false to disable the live call.
ENABLE_LIVE_WEATHER=true
# Currency: frankfurter.app needs no key. Set to false to use fallback rates.
ENABLE_LIVE_FX=true

# ---- Frontend (copy to frontend/.env) ----
VITE_API_URL=http://localhost:8000
